# Copy to .env and fill in.  cp .env.example .env

# Alpaca: https://app.alpaca.markets  -> switch to "Paper" account -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# AI that makes the decisions.
# FREE: Google Gemini -> https://aistudio.google.com/apikey (Google account, no card)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional paid alternative: AI_PROVIDER=anthropic + ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=
# Leave empty for the default model
AI_MODEL=

# Paper trading (fake money). Keep true until you've reviewed weeks of results.
PAPER=true
# To trade real money you must set PAPER=false AND paste this exact phrase:
# LIVE_TRADING_CONFIRM="I accept that real money can be lost"
LIVE_TRADING_CONFIRM=

WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,JPM,XLE,XLV,TLT,GLD
INTERVAL_MINUTES=60

# Risk limits - enforced in code, the AI cannot override them
MAX_POSITION_PCT=0.10
MAX_ORDER_USD=2000
MAX_TRADES_PER_DAY=6
DAILY_LOSS_LIMIT_PCT=0.03
MIN_CASH_RESERVE_PCT=0.20
MIN_CONFIDENCE=0.65
MAX_POSITIONS=8
